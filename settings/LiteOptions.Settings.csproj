<Project Sdk="Microsoft.NET.Sdk">
  <!-- LiteOptions settings window: WinUI 3, unpackaged, self-contained (no runtimes to install). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>LiteOptions.SettingsApp</RootNamespace>
    <AssemblyName>LiteOptions.Settings</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>2.2.3</Version>
    <Product>LiteOptions</Product>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CA1416;CS0649;CS0169;CS0414;CS8981;CsWinRT1028;CsWinRT1030;SYSLIB1054;SYSLIB0050;SYSLIB0051;IL2026;IL2104;IL3050</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <WinAppSdkVersion>2.6.4</WinAppSdkVersion>
    <!-- drop the unused parts of .NET and of the Windows API wrappers; our own code is kept whole -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- only the parts the window uses: not the whole SDK, which also ships ~50 MB of AI/ML, search and widget runtimes -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="$(WinAppSdkVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="$(WinAppSdkVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="$(WinAppSdkVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="$(WinAppSdkVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="$(WinAppSdkVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="$(WinAppSdkVersion)" />
  </ItemGroup>

  <!-- shared with the engine: settings model, actions/key names, Win32 interop, the pipe protocol -->
  <ItemGroup>
    <Compile Include="..\src\Settings.cs" Link="Shared\Settings.cs" />
    <Compile Include="..\src\Native.cs" Link="Shared\Native.cs" />
    <Compile Include="..\src\Input\Actions.cs" Link="Shared\Actions.cs" />
    <Compile Include="..\src\Ipc\Protocol.cs" Link="Shared\Protocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\assets\app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- photos of the Pebble Mouse 2 and K380 shown on the Mouse and Keyboard pages -->
    <Content Remove="Assets\**" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
